<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ct="using:Einsatzplanung.GUI.Controls"
					xmlns:cv="using:Einsatzplanung.GUI.Converters">

	<Design.PreviewWith>
		<Panel>
			<ct:ExtendingCard HeaderOrientation="Horizontal">
				<ct:ExtendingCard.HeaderContent>
					<TextBlock Text="Header" FontWeight="Bold" />
					<Button Content="Refresh" />
				</ct:ExtendingCard.HeaderContent>

				<TextBlock Text="First" />
				<TextBlock Text="Second" />

			</ct:ExtendingCard>
		</Panel>
    </Design.PreviewWith>

	<ControlTheme x:Key="{x:Type ct:ExtendingCard}" TargetType="ct:ExtendingCard">
		
		<!--set the contents of the templated controll ExtendingCard-->
		<Setter Property="Template">
			<ControlTemplate>
				<Grid Name="PART_Root" Background="Transparent">

					<Border Name="PART_Border"
							MinWidth="420"
							CornerRadius="6"
							BorderThickness="1"
							Padding="15"
							Margin="{Binding #PART_RemoveButton.Bounds, Converter={x:Static cv:HalfBoundsToMarginConverter.Instance}}"
							Background="{DynamicResource CardBackgroundBrush}"
							BorderBrush="{DynamicResource CardBorderBrush}"
							ClipToBounds="True">

						<Grid RowDefinitions="Auto,*,Auto">

						<DockPanel Name="PART_HeaderPanel"
									Grid.Row="0"
									LastChildFill="True"
									HorizontalSpacing="8"
									HorizontalAlignment="Stretch"
									Margin="0,0,0,20" />

							<!-- ScrollBar -->
						 
							<ScrollViewer Name="PART_Body"
										  Grid.Row="1"
										  Margin="0,0,-10,6.7"
										  AllowAutoHide="False">

								<ScrollViewer.Resources>
									<x:Double x:Key="ScrollBarSize">8</x:Double>
									<x:Double x:Key="ScrollBarThumbSize">6</x:Double>
								</ScrollViewer.Resources>
							
								<StackPanel Name="PART_BodyPanel"
											Grid.Row="1"
											Orientation="{TemplateBinding BodyOrientation}"
											HorizontalAlignment="Stretch"
											Margin="0,0,10,0"
											Spacing="12" />
							
							</ScrollViewer>
						
							<Grid ColumnDefinitions="Auto, *"
								  Grid.Row="2"
								  IsVisible="{TemplateBinding ShowAddButton}">
								<Button Grid.Column="1"
										Classes="list-button add"
										HorizontalAlignment="Right"
										Command="{TemplateBinding AddButtonCommand}"
										CommandParameter="{TemplateBinding RemoveButtonCommandParameter}"/>
							</Grid>

						</Grid>

					</Border>

					<Button Name="PART_RemoveButton"
							Width="20"
							Height="20"
							Classes="remove-button"
							CornerRadius="10"
							Command="{TemplateBinding RemoveButtonCommand}"
							CommandParameter="{TemplateBinding RemoveButtonCommandParameter}" />
				</Grid>

			</ControlTemplate>
		</Setter>

		<!--set the transition duration of the border of the template-->
		<Style Selector="^ /template/ Border#PART_Border">
			<Setter Property="Height" Value="60" />
			<Setter Property="Transitions" >
				<Transitions>	
					<DoubleTransition Property="Height"
									  Duration="0:0:0.2"
									  Easing="CubicEaseOut" />
				</Transitions>
			</Setter>	
		</Style>


		<!--set the height of the border of the template to 300 when active-->
		<Style Selector="^:active /template/ Border#PART_Border">
			<Setter Property="Height" Value="300" />
		</Style>

		<!--apply the transition to the border of the template-->
		<Style Selector="^ /template/ ScrollViewer#PART_Body">
			<Setter Property="IsVisible" Value="False" />
			<Setter Property="Opacity" Value="0" />
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.1" />
				</Transitions>
			</Setter>
		</Style>

		<!--show the body when pointer when pseudoclass 'active' exists-->
		<Style Selector="^:active /template/ ScrollViewer#PART_Body">
			<Setter Property="IsVisible" Value="True" />
			<Setter Property="Opacity" Value="1" />
		</Style>

	</ControlTheme>


	<ItemsPanelTemplate x:Key="ExtendingCardItemsPanel">
        <StackPanel Spacing="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />
    </ItemsPanelTemplate>

</ResourceDictionary>
