<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ct="using:Einsatzplanung.GUI.Controls"
					xmlns:vm="using:Einsatzplanung.GUI.Interfaces"
					xmlns:cv="using:Einsatzplanung.GUI.Converters">

	<ControlTheme x:Key="{x:Type ct:RemovableCard}" TargetType="ct:RemovableCard" x:DataType="vm:IRemovableCardViewModel">
		
		<Setter Property="Template">
		
			<ControlTemplate>

				<Grid Name="PART_Root" Background="Transparent">
						
					<Border Name="PART_ContentBorder"
							CornerRadius="6"				
							HorizontalAlignment="Stretch"
							BorderThickness="1"				
							Padding="10"
                    		Background="{DynamicResource CardBackgroundBrush}"
							BorderBrush="{DynamicResource CardBorderBrush}"
							ClipToBounds="True">
						
						<Border.Margin>
							<MultiBinding Converter="{x:Static cv:WidthAndHeightToMarginConverter.Instance}">
								<Binding Path="#PART_RemoveButton.Width" />
								<Binding Path="#PART_RemoveButton.Height" />
							</MultiBinding>
						</Border.Margin>

						<ContentPresenter Name="PART_ContentPresenter"
										  HorizontalAlignment="Stretch"
										  VerticalAlignment="Stretch"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}" />

					</Border>

					<Button Name="PART_RemoveButton"
							Width="20"
							Height="20"
							Classes="remove-button"
							CornerRadius="20"
							Command="{TemplateBinding RemoveButtonCommand}"
							CommandParameter="{Binding}" />
				</Grid>

			</ControlTemplate>

		</Setter>

	</ControlTheme>

</ResourceDictionary>
