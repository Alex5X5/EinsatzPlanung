<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ct="using:Einsatzplanung.GUI.Controls"
					xmlns:vm="using:Einsatzplanung.GUI.Interfaces"
					xmlns:cv="using:Einsatzplanung.GUI.Converters">

	<ControlTheme x:Key="{x:Type ct:RemovableCard}" TargetType="ct:RemovableCard" x:DataType="vm:IRemovableCardViewModel">
		<Setter Property="Template">
			<ControlTemplate>

				<Grid Name="PART_Root" Background="Transparent">
						
					<Border Name="PART_ContentBorder"
							CornerRadius="6"				
							HorizontalAlignment="Stretch"
							BorderThickness="1"				
							Padding="10"
							Margin="{Binding #PART_RemoveButton.Bounds, Converter={x:Static cv:HalfBoundsToMarginConverter.Instance}}"
                    		Background="{DynamicResource CardBackgroundBrush}"
							BorderBrush="{DynamicResource CardBorderBrush}"
							ClipToBounds="True">

						<ContentPresenter Name="PART_ContentPresenter"
										  HorizontalAlignment="Stretch"
										  VerticalAlignment="Stretch"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}" />

					</Border>

					<Button Name="PART_RemoveButton"
							Width="20"
							Height="20"
							Classes="remove-button"
							CornerRadius="20"
							Command="{TemplateBinding RemoveButtonCommand}"
							CommandParameter="{Binding}" />
				</Grid>

			</ControlTemplate>
		</Setter>
		
		<!--
		<Style Selector="^ /template/ Border#PART_ContentBorder">
			<Setter Property="Transitions">
				<Transitions>
					<ThicknessTransition Property="Margin"
										 Delay="0:0:0"
										 Duration="0:0:0.3"
										 Easing="CubicEaseOut" />
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="^:active /template/ Border#PART_ContentBorder">
			<Setter Property="Margin" Value="0,0,50,0" />
		</Style>

		<Style Selector="^ /template/ Button#PART_RemoveButton">
			<Setter Property="IsVisible" Value="False" />
			<Setter Property="Opacity" Value="0" />
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity"
									  Delay="0:0:0.25"
									  Duration="0:0:0.1"
									  Easing="CubicEaseOut" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="^:active /template/ Button#PART_RemoveButton">
			<Setter Property="IsVisible" Value="True" />
			<Setter Property="Opacity" Value="1" />
		</Style>
		-->

	</ControlTheme>

</ResourceDictionary>
