<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ct="using:Einsatzplanung.GUI.Controls"
                    xmlns:packaging="using:DocumentFormat.OpenXml.Packaging"
					xmlns:vm="using:Einsatzplanung.GUI.Interfaces">

	<ControlTheme x:Key="{x:Type ct:RemovableCard}" TargetType="ct:RemovableCard" x:DataType="vm:IRemovableCardViewModel">
		<Setter Property="Template">
			<ControlTemplate>

				<Panel Name="PART_Root" Background="Transparent">

					<Border Name="PART_ContentBorder"
							CornerRadius="6"				
							HorizontalAlignment="Stretch"
							BorderThickness="1"				
							Padding="10"
							Margin="0,10,10,0"
							VerticalAlignment="Bottom"
							Background="{DynamicResource CardBackgroundBrush}"
							BorderBrush="{DynamicResource CardBorderBrush}"
							ClipToBounds="True">

						<ContentPresenter Name="PART_ContentPresenter"
										  Grid.Row="0"
										  Grid.ColumnSpan="2"
										  HorizontalAlignment="Stretch"
										  VerticalAlignment="Stretch"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}" />

					</Border>

						<Button Name="PART_RemoveButton"
								Classes="list-button rem"
								HorizontalAlignment="Right"
        						VerticalAlignment="Top"
								Command="{TemplateBinding RemoveButtonCommand}"
								CommandParameter="{Binding}"/>
				</Panel>

			</ControlTemplate>
			
		</Setter>
		
	</ControlTheme>

</ResourceDictionary>
