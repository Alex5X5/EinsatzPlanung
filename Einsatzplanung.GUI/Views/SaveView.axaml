<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Einsatzplanung.GUI.ViewModels"	
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Einsatzplanung.GUI.Views.SaveView"
             x:DataType="vm:SaveViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Top" Margin="0,167,0,0">
        <ScrollViewer Grid.Row="0"
                      MaxHeight="140"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,30">
            <ItemsControl ItemsSource="{Binding ClassesNamesForSave}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClassSelectionItem">
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="20"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
            <Button Content="Ordner wählen" 
                    Background="{DynamicResource StandardButtonBackgroundColor}"
                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                    Command="{Binding SavePathCommand}"/>
            <Button Content="Export" 
                    Background="{DynamicResource StandardButtonBackgroundColor}"
                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                    Command="{Binding ExportCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                    Text="{Binding SelectedFolderPath}"  
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Margin="30,0,30,0"
                    FontSize="11"
                    Foreground="#4CAF50" />

        <TextBlock Grid.Row="3"
                    Text="{Binding ErrorString}"  
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Margin="30,0,30,0"
                    FontSize="11"
                    Foreground="#D44524" />

    </Grid>
</UserControl>
