<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="4 50"
             xmlns:pages="using:Einsatzplanung.GUI.Views.Edit"
             xmlns:vm="using:Einsatzplanung.GUI.ViewModels"
             x:Class="Einsatzplanung.GUI.Views.EditView"
             x:DataType="vm:EditViewModel">
    
    <Grid ColumnDefinitions="*" RowDefinitions="*, Auto"
          HorizontalAlignment="Center" VerticalAlignment="Top"
          Margin="0,20,0,0" Background="Transparent">
        
        <TabbedPage Grid.Row="0" TabPlacement="Top" Width="800" MinWidth="500" CornerRadius="20" Background="Transparent">

            <ContentPage Header="Schulklassen" Background="Transparent">
                <pages:ClassesPage />
            </ContentPage>

            <ContentPage Header="Ausbilder" Background="Transparent">
                <pages:TeacherPage />
            </ContentPage>

        </TabbedPage>
        
        <StackPanel Grid.Column="0" Grid.Row="1">
            <Button Content="Erstellen" Command="{Binding GoToNextPageCommand}" 
                    HorizontalAlignment="Center" Classes="standard-button" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
    
</UserControl>
