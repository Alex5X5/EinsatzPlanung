<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Einsatzplanung.GUI.ViewModels"		 
			 xmlns:v="using:Einsatzplanung.GUI.Views"		 
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="Einsatzplanung.GUI.Views.MainView"
			 x:DataType="vm:MainViewModel">
	
	<UserControl.DataTemplates>
		<DataTemplate DataType="vm:ImportViewModel">
			<v:ImportView />
		</DataTemplate>
	</UserControl.DataTemplates>
	
	<Grid ColumnDefinitions="*" RowDefinitions="Auto,*">
		<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
			<Image Source="{SvgImage /Assets/import.svg}"
			       Width="48"
			       Height="48"/>

			
			<Image Source="{SvgImage /Assets/edit.svg}"
			       Width="48"
			       Height="48"/>

			
           <Image Source="{SvgImage /Assets/save.svg}"
                  Width="48"
                  Height="48"/>


		</StackPanel>
	

		<ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
	</Grid>
</UserControl>
