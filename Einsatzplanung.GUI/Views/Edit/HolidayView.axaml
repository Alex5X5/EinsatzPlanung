<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Einsatzplanung.GUI.ViewModels.Edit"
			 xmlns:ct="using:Einsatzplanung.GUI.Controls"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="Einsatzplanung.GUI.Views.Edit.HolidayView"
			 x:DataType="vm:HolidayViewModel">

	<ct:EditCardsControl ItemsSource="{Binding Cards}">
		
		<ct:EditCardsControl.ItemTemplate>
			
			<DataTemplate x:DataType="vm:HolidayCardViewModel">

				<ct:ExtendingCard>

					<ct:ExtendingCard.HeaderContent>
						<TextBox Text="{Binding Header, Mode=TwoWay}"
								 TextWrapping="NoWrap"
								 Foreground="{DynamicResource AppForegroundBrush}"
								 HorizontalContentAlignment="Center"
								 VerticalContentAlignment="Center"
								 ToolTip.Tip="Urlaubs- oder Feiertagsbezeichnung" />
					</ct:ExtendingCard.HeaderContent>

				</ct:ExtendingCard>
			
			</DataTemplate>

		</ct:EditCardsControl.ItemTemplate>
	
	</ct:EditCardsControl>

</UserControl>