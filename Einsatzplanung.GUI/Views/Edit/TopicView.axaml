<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Einsatzplanung.GUI.ViewModels.Edit"
			 xmlns:ct="using:Einsatzplanung.GUI.Controls"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="Einsatzplanung.GUI.Views.Edit.TopicView"
			 x:DataType="vm:TopicViewModel"
			 Name="Root">

	<ct:EditCardsControl x:Name="GroupCardsControl" ItemsSource="{Binding Groups}">
		<ct:EditCardsControl.ItemTemplate>
			<DataTemplate x:DataType="vm:TopicCardGroupViewModel">
				<Border BorderBrush="{DynamicResource CardBorderBrush}"
						BorderThickness="1"
						CornerRadius="6"
						Background="{DynamicResource CardBackgroundBrush}"
						Padding="20,20,10,10">
					<ItemsControl ItemsSource="{Binding Cards}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Spacing="12" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:TopicCardViewModel">
								<ct:ExtendingCard AllowExtend="False"
												  ShowAddButton="False"
												  Index="{Binding Index}"
												  ActiveCardIndex="{Binding #Root.DataContext.ActiveCardIndex}"
												  RemoveButtonCommand="{Binding RemoveCommand}"
												  RemoveButtonCommandParameter="{Binding}">
									<ct:ExtendingCard.HeaderContent>
										<Grid RowDefinitions="*"
											  ColumnDefinitions="Auto, 16*, *, 3*"
											  HorizontalAlignment="Stretch">
											<Grid Grid.Column="0"
												  Width="22"
												  Height="24"
												  Margin="0,0,8,0"
												  Background="Transparent"
												  ColumnDefinitions="*,*"
												  RowDefinitions="*,*,*"
												  Cursor="SizeAll"
												  ToolTip.Tip="Ziehen, um das Thema zu verschieben"
												  PointerPressed="OnTopicDragPressed"
												  PointerMoved="OnTopicDragMoved"
												  PointerReleased="OnTopicDragReleased">
												<Ellipse Grid.Row="0" Grid.Column="0" Width="4" Height="4" Fill="{DynamicResource AppForegroundBrush}" />
												<Ellipse Grid.Row="0" Grid.Column="1" Width="4" Height="4" Fill="{DynamicResource AppForegroundBrush}" />
												<Ellipse Grid.Row="1" Grid.Column="0" Width="4" Height="4" Fill="{DynamicResource AppForegroundBrush}" />
												<Ellipse Grid.Row="1" Grid.Column="1" Width="4" Height="4" Fill="{DynamicResource AppForegroundBrush}" />
												<Ellipse Grid.Row="2" Grid.Column="0" Width="4" Height="4" Fill="{DynamicResource AppForegroundBrush}" />
												<Ellipse Grid.Row="2" Grid.Column="1" Width="4" Height="4" Fill="{DynamicResource AppForegroundBrush}" />
											</Grid>
											<TextBox Grid.Column="1"
													 Text="{Binding Header, Mode=TwoWay}"
													 PlaceholderText="Name des Themas"
													 TextWrapping="NoWrap"
													 Foreground="{DynamicResource AppForegroundBrush}"
													 HorizontalContentAlignment="Center"
													 VerticalContentAlignment="Center"
													 ToolTip.Tip="Der Name des Themas"/>
											<ColorPicker Grid.Column="3"
														 Color="{Binding SelectedColor, Mode=TwoWay}"
														 HorizontalAlignment="Stretch"
														 ToolTip.Tip="Die Farbe die das Thema im Einsatzplan haben wird"/>
										</Grid>
									</ct:ExtendingCard.HeaderContent>
								</ct:ExtendingCard>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
			</DataTemplate>
		</ct:EditCardsControl.ItemTemplate>
	</ct:EditCardsControl>

</UserControl>