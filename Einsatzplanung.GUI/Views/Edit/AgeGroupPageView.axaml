<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Einsatzplanung.GUI.ViewModels.Edit"
             xmlns:ct="using:Einsatzplanung.GUI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Einsatzplanung.GUI.Views.Edit.AgeGroupPageView"
             x:DataType="vm:AgeGroupPageViewModel"
             Name="Root">
             
    <!-- Lehrjahr -->
    <Grid ColumnDefinitions="3*, 17*, 3*">
                    
        <StackPanel Grid.Column="0"
                    Orientation="Vertical"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding Cards}"
                          ItemsPanel="{StaticResource ExtendingCardItemsPanel}"
                          Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgeGroupCardViewModel">
                        <ct:RedirectOrEditButton Text="{Binding Header}"
                                                 IsActive="{Binding IsActive}"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Center"
                                                 RemoveCommand="{Binding RemoveCommand}"
                                                 RemoveCommandParameter="{Binding}"
                                                 RedirectCommand="{Binding RedirectCommand}"
                                                 RedirectCommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel>
                <Button Classes="list-button add"
                        CornerRadius="15"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Center"
                        Margin="0,5,8,0"
                        Command="{Binding AddAgeGroupCommand}"
                        ToolTip.Tip="Neues Lehrjahr hinzufügen" />
            </StackPanel>
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding ActiveCard}">

            <ContentControl.DataTemplates>

                 <DataTemplate x:DataType="vm:AgeGroupCardViewModel">

                    <ct:EditCardsControl ItemsSource="{Binding Cards}">
                        <ct:EditCardsControl.ItemTemplate>

                        <DataTemplate x:DataType="vm:GroupCardViewModel">
                            <ct:ExtendingCard Index="{Binding Index}"
                                              ActiveCardIndex="{Binding #Root.((vm:AgeGroupPageViewModel)DataContext).ActiveGroupCardIndex}"
                                              AddButtonCommand="{Binding AddTopicCommand}"
                                              RemoveButtonCommand="{Binding RemoveCommand}"
                                              RemoveButtonCommandParameter="{Binding}">

                            <ct:ExtendingCard.HeaderContent>
                                <ct:NoScrollComboBox ItemsSource="{Binding Abbreviations}"
                                                     SelectedItem="{Binding TeacherAbbreviation, Mode=TwoWay}"
                                                     PlaceholderText="Ausbilder"
                                                     Foreground="{DynamicResource AppForegroundBrush}"
                                                     HorizontalAlignment="Stretch"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip.Tip="Ausbilder Auswählen" />

                                <TextBox Text="{Binding Header, Mode=TwoWay}"
                                        PlaceholderText="Name der Klasse"
                                        TextWrapping="NoWrap"
                                        Foreground="{DynamicResource AppForegroundBrush}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="Klassenbezeichnung eingeben" />
                            </ct:ExtendingCard.HeaderContent>

                            <ItemsControl ItemsSource="{Binding Topics}"
                                            ItemsPanel="{StaticResource ExtendingCardItemsPanel}">
                                <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlockCardViewModel">
                                    <ct:RemovableCard RemoveButtonCommand="{Binding RemoveCommand}"
                                                      DragDrop.AllowDrop="True"
                                                      PointerPressed="Item_PointerPressed"
                                                      PointerMoved="Item_PointerMoved"
                                                      PointerReleased="Item_PointerReleased"
                                                      DragDrop.DragOver="Item_DragOver"
                                                      DragDrop.Drop="Item_Drop">
                                    <Grid ColumnDefinitions="19*, *, 3*">
                                        <ct:NoScrollComboBox Grid.Column="0"
                                                             ItemsSource="{Binding TopicNames}"
                                                             SelectedItem="{Binding Header, Mode=TwoWay}"
                                                             Foreground="{DynamicResource AppForegroundBrush}"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalContentAlignment="Center"
                                                             ToolTip.Tip="Der Name des Themas" />
                                        <TextBox Grid.Column="2"
                                                Text="{Binding Count, Mode=TwoWay}"
                                                TextWrapping="NoWrap"
                                                Foreground="{DynamicResource AppForegroundBrush}"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                ToolTip.Tip="Die Anzahl an Wochen des Themas" />
                                    </Grid>
                                    </ct:RemovableCard>
                                </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            </ct:ExtendingCard>
                        </DataTemplate>

                        </ct:EditCardsControl.ItemTemplate>
                    </ct:EditCardsControl>

                </DataTemplate>

            </ContentControl.DataTemplates>

        </ContentControl>
    </Grid>

    
</UserControl>