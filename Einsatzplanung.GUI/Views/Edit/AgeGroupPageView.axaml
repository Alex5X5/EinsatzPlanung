<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Einsatzplanung.GUI.ViewModels.Edit"
			 xmlns:ct="using:Einsatzplanung.GUI.Controls"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="Einsatzplanung.GUI.Views.Edit.AgeGroupPageView"
			 x:DataType="vm:AgeGroupPageViewModel"
			 Name="Root">
	
	<!--Lehrjahre-->
	<!--<ct:EditCardsControl ItemsSource="{Binding Cards}">
		
		<ct:EditCardsControl.ItemTemplate>

			<DataTemplate x:DataType="vm:AgeGroupCardViewModel">

				<ct:ExtendingCard Index="{Binding Index}"
								  ActiveCardIndex="{Binding #Root.DataContext.ActiveAgeGroupCardIndex}"
								  ExtendedHeight="500"
								  AddButtonCommand="{Binding AddGroupCommand}"
								  RemoveButtonCommand="{Binding RemoveCommand}"
								  RemoveButtonCommandParameter="{Binding}">
					
					<ct:ExtendingCard.HeaderContent>

						<TextBox Text="{Binding Header, Mode=TwoWay}"
								 PlaceholderText="Name des Lehrjahres"
								 TextWrapping="NoWrap"
								 Foreground="{DynamicResource AppForegroundBrush}"
								 HorizontalAlignment="Stretch"
								 HorizontalContentAlignment="Center"
								 VerticalContentAlignment="Center"
								 ToolTip.Tip="Name des Lehrjahres eingeben" />

					</ct:ExtendingCard.HeaderContent>-->
	
	<Grid>
  <TabControl ItemsSource="{Binding Cards}">
	  
    <TabControl.ItemTemplate>
      <DataTemplate x:DataType="vm:AgeGroupCardViewModel">
        <TextBlock Text="{Binding Header}" />
      </DataTemplate>
    </TabControl.ItemTemplate>
    
    <TabControl.ContentTemplate>
      <DataTemplate x:DataType="vm:AgeGroupCardViewModel">

        <ct:EditCardsControl ItemsSource="{Binding Cards}">
          <ct:EditCardsControl.ItemTemplate>

            <DataTemplate x:DataType="vm:GroupCardViewModel">
              <ct:ExtendingCard Index="{Binding Index}"
                                ActiveCardIndex="{Binding #Root.((vm:AgeGroupPageViewModel)DataContext).ActiveGroupCardIndex}"
                                AddButtonCommand="{Binding AddTopicCommand}"
                                RemoveButtonCommand="{Binding RemoveCommand}"
                                RemoveButtonCommandParameter="{Binding}">

									<ct:ExtendingCard.HeaderContent>

										<ct:NoScrollComboBox ItemsSource="{Binding Abbreviations}"
															 SelectedItem="{Binding TeacherAbbreviation, Mode=TwoWay}"
															 PlaceholderText="Ausbilder"
															 Foreground="{DynamicResource AppForegroundBrush}"
															 HorizontalAlignment="Stretch"
															 HorizontalContentAlignment="Center"
															 VerticalContentAlignment="Center"
															 ToolTip.Tip="Name der Ausbildungskraft" />

										<TextBox Text="{Binding Header, Mode=TwoWay}"
												 PlaceholderText="Name der Klasse"
												 TextWrapping="NoWrap"
												 Foreground="{DynamicResource AppForegroundBrush}"
												 HorizontalAlignment="Stretch"
												 HorizontalContentAlignment="Center"
												 VerticalContentAlignment="Center"
												 ToolTip.Tip="Name der Klasse" />

									</ct:ExtendingCard.HeaderContent>
									
									<ItemsControl ItemsSource="{Binding Topics}"
												  ItemsPanel="{StaticResource ExtendingCardItemsPanel}">

										<ItemsControl.ItemTemplate>

											<DataTemplate x:DataType="vm:BlockCardViewModel">

													<ct:RemovableCard RemoveButtonCommand="{Binding RemoveCommand}">

														<Grid RowDefinitions="*" ColumnDefinitions="19*, *, 3*">
															<ct:NoScrollComboBox Grid.Column="0"
																				 ItemsSource="{Binding TopicNames}"
																				 SelectedItem="{Binding Header, Mode=TwoWay}"
																				 Foreground="{DynamicResource AppForegroundBrush}"
																				 HorizontalAlignment="Stretch"
																				 VerticalContentAlignment="Center" 
																				 ToolTip.Tip="Name des Themas" />
															<TextBox Grid.Column="2"
																	 Text="{Binding Count, Mode=TwoWay}"
																	 TextWrapping="NoWrap"
																	 Foreground="{DynamicResource AppForegroundBrush}"
																	 HorizontalContentAlignment="Center"
																	 VerticalContentAlignment="Center" 
																	 ToolTip.Tip="Anzahl an Wochen des Themas"/>
														</Grid>

													</ct:RemovableCard>

												</DataTemplate>

										</ItemsControl.ItemTemplate>
					
									</ItemsControl>

              </ct:ExtendingCard>
            </DataTemplate>

          </ct:EditCardsControl.ItemTemplate>
        </ct:EditCardsControl>

      </DataTemplate>
    </TabControl.ContentTemplate>
  </TabControl>
</Grid>

				<!--</ct:ExtendingCard>

			</DataTemplate>

		</ct:EditCardsControl.ItemTemplate>
	
	</ct:EditCardsControl>-->
	
</UserControl>