<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundStartColor">#FFFF</Color>
            <Color x:Key="AppBackgroundEndColor">#FFFF</Color>
            <Color x:Key="AppForegroundColor">#FF000000</Color>
            
            <Color x:Key="TapItemBackgroundBrush">#FFF</Color>
            <Color x:Key="TapItemForegroundBrush">Black</Color>
            <Color x:Key="SelectedTapItemBackgroundBrush">#BA7296</Color>
            <Color x:Key="SelectedTapItemForegroundBrush">#FFF</Color>
            <Color x:Key="PointeroverTapItemForegroundBrush">#BA7296</Color>
            
            <Color x:Key="CardBackgroundColor">#F2F0FF</Color>
            <Color x:Key="CardBorderBrush">#40000000</Color>
            
            <Color x:Key="SeparatorColor">#87375F</Color>
            
            <Color x:Key="ButtonBorderBrush">#000000</Color>
            <Color x:Key="ImportButtonBackgroundColor">#DCD4D1D2</Color>
            <Color x:Key="HoverImportButtonBackgroundColor">#95D4DFDF</Color>
            <Color x:Key="StandardButtonBackgroundColor">#FFFFFFFF</Color>
            
            <SvgImage x:Key="SvgImportIco">  /Assets/Light/import.svg </SvgImage>
            <SvgImage x:Key="SvgEditIco">  /Assets/Light/edit.svg </SvgImage>
            <SvgImage x:Key="SvgSaveIco">  /Assets/Light/save.svg </SvgImage>

            <LinearGradientBrush x:Key="AppBackgroundBrush"
                                 StartPoint="0%,0%"
                                 EndPoint="100%,100%">
                <GradientStop Color="{StaticResource AppBackgroundStartColor}"
                              Offset="0" />
                <GradientStop Color="{StaticResource AppBackgroundEndColor}"
                              Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="AppForegroundBrush"
                             Color="{StaticResource AppForegroundColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush"
                             Color="{StaticResource CardBackgroundColor}" />
        </ResourceDictionary>

        
        
        <!-- DARK THEME -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundStartColor">#211B2B</Color>
            <Color x:Key="AppBackgroundEndColor">#2B2138</Color>
            <Color x:Key="AppForegroundColor">#FFFFFFFF</Color>
            
            <Color x:Key="TapItemBackgroundBrush">#362F43</Color>
            <Color x:Key="TapItemForegroundBrush">#FFFFFF</Color>
            <Color x:Key="SelectedTapItemBackgroundBrush">#483D55</Color>
            <Color x:Key="SelectedTapItemForegroundBrush">#FFFFFF</Color>
            <Color x:Key="PointeroverTapItemForegroundBrush">#827CEA</Color>
            
            <Color x:Key="CardBackgroundColor">#20FFFFFF</Color>
            <Color x:Key="CardBorderBrush">#FFFFFF</Color>
            
            <Color x:Key="SeparatorColor">#FFFFFF</Color>
            
            <Color x:Key="ButtonBorderBrush">#FFFFFF</Color>
            <Color x:Key="ImportButtonBackgroundColor">#E1505050</Color>
            <Color x:Key="HoverImportButtonBackgroundColor">#20FFFFFF</Color>
            <Color x:Key="StandardButtonBackgroundColor">#20FFFFFF</Color>
            
             <SvgImage x:Key="SvgImportIco">  /Assets/Dark/import.svg </SvgImage>
             <SvgImage x:Key="SvgEditIco">  /Assets/Dark/edit.svg </SvgImage>
             <SvgImage x:Key="SvgSaveIco">  /Assets/Dark/save.svg </SvgImage>

            <LinearGradientBrush x:Key="AppBackgroundBrush"
                                 StartPoint="0%,0%"
                                 EndPoint="100%,100%">
                <GradientStop Color="{StaticResource AppBackgroundStartColor}"
                              Offset="0" />
                <GradientStop Color="{StaticResource AppBackgroundEndColor}"
                              Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="AppForegroundBrush"
                             Color="{StaticResource AppForegroundColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush"
                             Color="{StaticResource CardBackgroundColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
    
    <!-- ALL THEMES -->
                
    <LinearGradientBrush x:Key="ExcelImportButtonGradient"
                         StartPoint="0%,0%"
                         EndPoint="100%,0%">

        <GradientStop
            Color="#217346"
            Offset="0" />

        <GradientStop
            Color="#33A852"
            Offset="1" />

    </LinearGradientBrush>    
    
    
    
    <LinearGradientBrush x:Key="HoverExcelImportButtonGradient"
                         StartPoint="50%,0%"
                         EndPoint="100%,0%">

        <GradientStop
            Color="#217346"
            Offset="0" />

        <GradientStop
            Color="#33A852"
            Offset="1" />

        
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PdfImportButtonGradient"
        StartPoint="0%,0%"
        EndPoint="100%,0%">

        <GradientStop
            Color="#B72834"
            Offset="0" />

        <GradientStop
            Color="#FD3D4C"
            Offset="1" />

    </LinearGradientBrush>    
    
    <LinearGradientBrush x:Key="HoverPdfImportButtonGradient"
                         StartPoint="50%,0%"
                         EndPoint="100%,0%">

        <GradientStop
            Color="#B72834"
            Offset="0" />

        <GradientStop
            Color="#FD3D4C"
            Offset="1" />


    </LinearGradientBrush>
    

</ResourceDictionary>