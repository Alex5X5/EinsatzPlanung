<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ALL THEMES -->
    
    <LinearGradientBrush x:Key="ExcelImportButtonGradient"
                         StartPoint="0%,0%"
                         EndPoint="100%,0%">

        <GradientStop
            Color="#217346"
            Offset="0" />

        <GradientStop
            Color="#33A852"
            Offset="1" />

    </LinearGradientBrush>    
    
    
    
    <LinearGradientBrush x:Key="HoverExcelImportButtonGradient"
                         StartPoint="50%,0%"
                         EndPoint="100%,0%">

        <GradientStop
            Color="#217346"
            Offset="0" />

        <GradientStop
            Color="#33A852"
            Offset="1" />

        
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PdfImportButtonGradient"
        StartPoint="0%,0%"
        EndPoint="100%,0%">

        <GradientStop
            Color="#B72834"
            Offset="0" />

        <GradientStop
            Color="#FD3D4C"
            Offset="1" />

    </LinearGradientBrush>    
    
    <LinearGradientBrush x:Key="HoverPdfImportButtonGradient"
                         StartPoint="50%,0%"
                         EndPoint="100%,0%">

        <GradientStop
            Color="#B72834"
            Offset="0" />

        <GradientStop
            Color="#FD3D4C"
            Offset="1" />


    </LinearGradientBrush>
    

</ResourceDictionary>