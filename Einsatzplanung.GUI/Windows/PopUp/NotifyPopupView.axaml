<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Einsatzplanung.GUI.ViewModels.PopUp"
        xmlns:cls="clr-namespace:Einsatzplanung.GUI.Windows.PopUp"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="50"
        Width="300"
        Height="150"
        CanMaximize="False"
        CanMinimize="False"
        CanResize="False"
        x:Class="Einsatzplanung.GUI.Windows.PopUp.NotifyPopupView"
        x:DataType="vm:NotifyPopupViewModel"
        Title="{Binding Header}"
        Background="{DynamicResource AppBackgroundBrush}">
        
        <Window.Styles>
                <Style Selector="Border.error">
                        <Setter Property="Background"
                                Value="{DynamicResource ErrorColor}" />
                </Style>

                <Style Selector="Border.normal">
                        <Setter Property="Background"
                                Value="{DynamicResource AppBackgroundBrush}" />
                </Style>
        </Window.Styles>
        
        
        
        <Border Classes.error="{Binding IsError}" 
                Classes.normal="{Binding !IsError}" >
                <Grid ColumnDefinitions="*" RowDefinitions="*, *, *, *" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Grid.Row="0" Text="{Binding Message}"/>
                        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}"/>
                        <Separator Grid.Row="2" Margin="0,0,0,20" Background="Transparent"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                                <Button Classes="standard-button" MinWidth="50"
                                        Content="Ok"
                                        Command="{Binding $parent[cls:NotifyPopupView].CloseWindowCommand}"/>
                        </StackPanel>
                </Grid>
        </Border>
</Window>
