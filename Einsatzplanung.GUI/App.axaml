<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Einsatzplanung.GUI.App"
             xmlns:local="using:Einsatzplanung"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
             
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Einsatzplanung.GUI/Resources/SharedThemeResources.axaml" />
                <ResourceInclude Source="avares://Einsatzplanung.GUI/Resources/ControlResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="avares://Einsatzplanung.GUI/Resources/LightTheme.axaml" />
                <ResourceInclude x:Key="Dark"  Source="avares://Einsatzplanung.GUI/Resources/DarkTheme.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="/Styles/Styles.axaml"/>
        
        
        <!-- Override accent colors set by windows 
        Can maybe be moved to ThemeResources.axaml but have to consider overrides -->
        
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="{DynamicResource AccentColor}" />
                <ColorPaletteResources x:Key="Dark"  Accent="{DynamicResource AccentColor}"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        
    </Application.Styles>
</Application>