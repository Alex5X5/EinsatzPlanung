<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Einsatzplanung.GUI.App"
             xmlns:local="using:Einsatzplanung"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
             
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Einsatzplanung.GUI/Resources/ThemeResources.axaml" />
                <ResourceInclude Source="avares://Einsatzplanung.GUI/Controls/ExtendingCard.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        
        <StyleInclude Source="/Styles/Styles.axaml"/>
        
        <FluentTheme />
    </Application.Styles>
</Application>