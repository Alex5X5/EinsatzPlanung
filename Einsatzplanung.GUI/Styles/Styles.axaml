<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
    <StyleInclude Source="avares://Einsatzplanung.GUI/Styles/Buttons.axaml"/>
    <StyleInclude Source="avares://Einsatzplanung.GUI/Styles/Borders.axaml"/>
    <StyleInclude Source="avares://Einsatzplanung.GUI/Styles/Tapitems.axaml"/>
    <StyleInclude Source="avares://Einsatzplanung.GUI/Styles/Scrollview.axaml"/>

    <!-- Calendar -->
    <Style Selector="CalendarDatePicker">
        <Setter Property="IsDropDownOpen" Value="False"/> <!-- is buggy -->
    </Style>
    
    <!-- img -->
    
    <Style Selector="Image.glow">
        <Setter Property="Effect">
            <DropShadowEffect 
                Color="{DynamicResource SeparatorColor}"
                BlurRadius="40"
                Opacity="0.9"
                OffsetX="0"
                OffsetY="0"
                />
        </Setter>
    </Style>

</Styles>
