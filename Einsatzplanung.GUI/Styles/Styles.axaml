<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
    <StyleInclude Source="avares://Einsatzplanung.GUI/Styles/Buttons.axaml"/>
    <StyleInclude Source="avares://Einsatzplanung.GUI/Styles/Borders.axaml"/>
    <StyleInclude Source="avares://Einsatzplanung.GUI/Styles/Tapitems.axaml"/>
    <StyleInclude Source="avares://Einsatzplanung.GUI/Styles/Scrollview.axaml"/>

    <!-- Calendar -->
    <Style Selector="CalendarDatePicker">
        <Setter Property="IsDropDownOpen" Value="False" /> <!-- is buggy -->
    </Style>
    
    <!-- img -->
    
    <Style Selector="Image.glow">
        <Setter Property="Effect">
            <DropShadowEffect 
                Color="{DynamicResource SeparatorColor}"
                BlurRadius="40"
                Opacity="0.9"
                OffsetX="0"
                OffsetY="0"
                />
        </Setter>
    </Style>
    
    <!-- TextBox -->
    
    <Style Selector="TextBox">
        <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
    </Style>
    
    <!-- ComboBox -->
    
    <Style Selector="ComboBox">
        <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
    </Style>

    <!-- ColorPicker --> 
    
    <Style Selector="ColorPicker">
        <Setter Property="IsAlphaEnabled" Value="False" />
        <Setter Property="IsAlphaVisible" Value="False" />
        <Setter Property="ColorSpectrumShape" Value="Box" /> <!-- Possible Values: Ring / Box (Default) -->
    </Style>
    
    <Style Selector="ColorPicker /template/ DropDownButton">
        <Setter Property="Background" Value="{DynamicResource StandardButtonBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}"/>
    </Style>
    
    
</Styles>
